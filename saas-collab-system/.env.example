DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MySQL is the standard database target. Values below are examples only.
DB_ENGINE=django.db.backends.mysql
DB_NAME=saas_collab_dev
DB_USER=saas_collab_user
DB_PASSWORD=change-me-db-password
DB_HOST=mysql
DB_PORT=3306

# Docker MySQL 8 example variables. Do not use real production secrets here.
MYSQL_DATABASE=saas_collab_dev
MYSQL_USER=saas_collab_user
MYSQL_PASSWORD=change-me-db-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root-password

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SYNC_JOB_LEASE_SECONDS=900

# Credential custody is intentionally refuse-by-default. File custody is only
# for explicit local synthetic/test runs and must never be used for live mode.
LIVE_CUSTODY_BACKEND=refuse
# For local synthetic/test only, explicitly select the file adapter and set
# both values outside production:
# CREDENTIAL_CUSTODY_PATH=C:/path/to/local/test-custody
# For approved live access, use an independently operated HTTPS custody service:
# LIVE_CUSTODY_BACKEND=http
# LIVE_CUSTODY_SERVICE_URL=https://custody.example.internal
# LIVE_CUSTODY_SERVICE_HOST=custody.example.internal
# Prefer a runtime-mounted owner-only token file. Do not put a real token in
# this example or in Git:
# LIVE_CUSTODY_SERVICE_TOKEN_FILE=/run/secrets/saas-collab-custody-token
# The legacy environment-token setting remains supported for controlled
# environments, but its value must never be committed:
# LIVE_CUSTODY_SERVICE_TOKEN=replace-with-runtime-secret
# Sidecar-only settings (the key file is read by the sidecar, not the SaaS
# business container):
# CUSTODY_SERVICE_STORAGE_PATH=/var/lib/saas-collab-custody
# CUSTODY_SERVICE_KEY_FILE=/run/secrets/saas-collab-custody-fernet-key
# LIVE_CUSTODY_CA_FILE=/run/secrets/saas-collab-custody-ca.pem
# CUSTODY_SERVICE_TLS_CERT_FILE=/etc/saas-collab-custody/tls/tls.crt
# CUSTODY_SERVICE_TLS_KEY_FILE=/run/secrets/saas-collab-custody-tls-key
