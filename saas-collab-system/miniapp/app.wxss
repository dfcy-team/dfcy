page {
  min-height: 100%;
  background: #f4f7fb;
  color: #1f2d3d;
  font-size: 28rpx;
}

view,
text,
button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 64rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #dce5ef;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(23, 58, 99, 0.06);
}

.page-title {
  color: #173a63;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #62748a;
  line-height: 1.6;
}

.primary-button {
  border-radius: 14rpx;
  background: #2f74b8;
  color: #ffffff;
  font-weight: 600;
}

.secondary-button {
  border: 1rpx solid #b8c8d9;
  border-radius: 14rpx;
  background: #ffffff;
  color: #173a63;
}

.muted {
  color: #75869a;
}
