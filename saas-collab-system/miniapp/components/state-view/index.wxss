.state-view {
  padding: 40rpx 28rpx;
  border: 1rpx solid #dce5ef;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.state-indicator {
  width: 20rpx;
  height: 20rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #8aa0b7;
}

.state-loading .state-indicator {
  background: #2f74b8;
}

.state-error .state-indicator {
  background: #c43b3b;
}

.state-offline .state-indicator,
.state-degraded .state-indicator {
  background: #d49216;
}

.state-title {
  color: #173a63;
  font-size: 32rpx;
  font-weight: 600;
}

.state-description {
  margin-top: 12rpx;
  color: #6c7e91;
  line-height: 1.6;
}

.state-action {
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #2f74b8;
  color: #ffffff;
  font-size: 28rpx;
}
