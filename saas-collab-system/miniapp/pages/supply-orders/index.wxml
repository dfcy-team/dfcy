<view class="page">
  <view class="boundary card">
    <view class="boundary-title">SC-F1 本机开发</view>
    当前只连接本地 Mock 或受控 Django API，不连接线上 Supabase，不迁移生产数据。
  </view>

  <view wx:if="{{state === 'ready'}}">
    <view class="summary card">
      <view class="summary-number">{{total}}</view>
      <view class="muted">当前供应商可见采购单</view>
    </view>

    <view
      wx:for="{{orders}}"
      wx:key="id"
      class="order card"
      data-id="{{item.id}}"
      bindtap="openOrder"
      role="button"
      aria-label="查看采购单 {{item.order_no}}"
    >
      <view class="order-header">
        <text class="order-no">{{item.order_no}}</text>
        <text class="order-status status-{{item.status}}">{{item.status_label}}</text>
      </view>
      <view class="order-supplier">{{item.supplier_name}}</view>
      <view class="order-meta">
        <text>数量 {{item.total_quantity}}</text>
        <text>已完成 {{item.completed_quantity}}</text>
        <text>交期 {{item.expected_delivery_date}}</text>
      </view>
      <view class="progress-track">
        <view class="progress-value" style="width: {{item.progress_percent}}%;"></view>
      </view>
      <view class="progress-label">生产进度 {{item.progress_percent}}%</view>
    </view>
    <button
      wx:if="{{hasMore}}"
      class="load-more"
      loading="{{loadingMore}}"
      disabled="{{loadingMore}}"
      bindtap="loadMore"
    >
      {{loadingMore ? "正在加载" : "加载更多"}}
    </button>
    <view wx:else class="list-end muted">已显示全部 {{total}} 条采购单</view>
  </view>

  <state-view
    wx:elif="{{state === 'empty'}}"
    state="empty"
    title="暂无采购单"
    description="当前租户和供应商范围内没有可见采购单。"
  />
  <state-view
    wx:elif="{{state === 'error'}}"
    state="error"
    title="加载失败"
    description="{{errorMessage}}"
    action-text="重新加载"
    bind:action="loadOrders"
  />
  <state-view
    wx:else
    state="loading"
    title="正在加载"
    description="正在读取当前供应商的采购单。"
  />
</view>
