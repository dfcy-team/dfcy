.login-page {
  padding-top: 120rpx;
}

.brand {
  margin-bottom: 56rpx;
  text-align: center;
}

.brand-mark {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #173a63;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
}

.environment-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.environment-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f1fa;
  color: #2f74b8;
  font-size: 24rpx;
}

.mock-notice {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fff6da;
  color: #7a5a00;
  line-height: 1.6;
}

.error-message {
  margin-top: 24rpx;
  color: #b62828;
}

.login-button {
  margin-top: 32rpx;
}

.security-note {
  padding: 0 20rpx;
  color: #75869a;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}
