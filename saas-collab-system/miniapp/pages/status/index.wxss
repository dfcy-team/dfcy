.diagnostic-row {
  display: flex;
  min-height: 80rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf1f5;
}

.diagnostic-row:last-child {
  border-bottom: 0;
}

.diagnostic-url {
  align-items: flex-start;
  padding: 22rpx 0;
  gap: 30rpx;
}

.diagnostic-url text:last-child {
  max-width: 72%;
  overflow-wrap: anywhere;
  text-align: right;
}
