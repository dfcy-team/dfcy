.safe-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.status-line, .meta-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16rpx; }
.status-line { color: #173a63; font-weight: 700; }
.state { padding: 6rpx 12rpx; border-radius: 999rpx; background: #eaf3fc; color: #245d91; font-size: 22rpx; font-weight: 400; }
.meta-grid { margin-top: 18rpx; color: #718398; font-size: 23rpx; }
.site-card, .evidence-card { margin-top: 20rpx; }
.site-name { margin-top: 14rpx; color: #173a63; font-size: 30rpx; font-weight: 700; }
.site-address, .site-contact { margin-top: 12rpx; color: #5e7185; line-height: 1.7; overflow-wrap: anywhere; }
.boundary { margin: 16rpx 0; padding: 18rpx; border: 1rpx solid #f1d496; border-radius: 12rpx; background: #fff9ea; color: #6f571d; line-height: 1.6; }
button { margin-top: 18rpx; }
