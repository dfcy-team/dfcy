.read-only-banner {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid #c7d9eb;
  border-radius: 14rpx;
  background: #edf5fc;
  color: #31577d;
  line-height: 1.6;
}

.read-only-label {
  margin-right: 14rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #2f74b8;
  color: #ffffff;
  font-size: 22rpx;
}

.summary-number {
  color: #173a63;
  font-size: 64rpx;
  font-weight: 700;
}

.status-grid {
  display: grid;
  margin-top: 28rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.status-card {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f4f7fb;
}

.status-count {
  color: #173a63;
  font-size: 34rpx;
  font-weight: 700;
}

.status-name {
  margin-top: 4rpx;
  color: #718398;
  font-size: 22rpx;
}

.section-title {
  margin: 36rpx 0 20rpx;
  color: #173a63;
  font-size: 34rpx;
  font-weight: 700;
}

.contract-header,
.contract-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contract-no {
  color: #173a63;
  font-weight: 700;
}

.contract-status {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3d4;
  color: #7a5a00;
  font-size: 22rpx;
}

.status-completed {
  background: #e7f5ec;
  color: #267047;
}

.status-release_failed,
.status-review_failed,
.status-rollback_required {
  background: #fdeaea;
  color: #a02727;
}

.contract-app {
  margin-top: 18rpx;
  color: #53677d;
}

.contract-meta {
  margin-top: 22rpx;
  color: #7a8b9d;
  font-size: 24rpx;
}
