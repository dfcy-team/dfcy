<view class="page">
  <view class="read-only-banner">
    <text class="read-only-label">只读</text>
    小程序仅展示合同与门禁证据，不提供审批、发布或回退操作。
  </view>

  <view wx:if="{{state === 'ready'}}">
    <view class="summary card">
      <view class="summary-number">{{total}}</view>
      <view class="muted">可见发布合同</view>
      <view class="status-grid">
        <view wx:for="{{statusCards}}" wx:key="status" class="status-card">
          <view class="status-count">{{item.count}}</view>
          <view class="status-name">{{item.status}}</view>
        </view>
      </view>
    </view>

    <view class="section-title">最近更新</view>
    <view
      wx:for="{{recent}}"
      wx:key="id"
      class="contract card"
      data-id="{{item.id}}"
      bindtap="openContract"
      role="button"
      aria-label="查看发布合同 {{item.contract_no}}"
    >
      <view class="contract-header">
        <text class="contract-no">{{item.contract_no}}</text>
        <text class="contract-status status-{{item.status}}">{{item.status}}</text>
      </view>
      <view class="contract-app">{{item.application_code}} · {{item.environment}}</view>
      <view class="contract-meta">
        <text>风险：{{item.risk_level}}</text>
        <text>门禁：{{item.gate_summary.passed_count}}/{{item.gate_summary.required}}</text>
      </view>
    </view>
  </view>

  <state-view
    wx:elif="{{state === 'empty'}}"
    state="empty"
    title="暂无发布合同"
    description="当前租户和权限范围内没有可展示的合同。"
  />

  <state-view
    wx:elif="{{state === 'error'}}"
    state="error"
    title="加载失败"
    description="{{errorMessage}}"
    action-text="重新加载"
    bind:action="loadWorkbench"
  />

  <state-view
    wx:else
    state="loading"
    title="正在加载"
    description="正在读取发布合同和门禁摘要。"
  />
</view>
