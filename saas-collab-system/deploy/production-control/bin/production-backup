#!/usr/bin/env bash
set -Eeuo pipefail

release_sha=""
while (($#)); do
  case "$1" in
    --release-sha) (($# >= 2)) || exit 2; release_sha=$2; shift 2 ;;
    *) exit 2 ;;
  esac
done
[[ "$release_sha" =~ ^[0-9a-f]{40}$ ]] || exit 2

backup_dir=${PRODUCTION_BACKUP_DIR:-/home/dfcy01/backups/production-control}
mkdir -p "$backup_dir"
chmod 700 "$backup_dir"
stamp=$(date -u '+%Y%m%dT%H%M%SZ')
target="$backup_dir/${stamp}-${release_sha}.sql.gz"
tmp="$target.tmp"
trap 'rm -f -- "$tmp"' EXIT HUP INT TERM

db_user=$(docker exec application-backend-1 printenv DB_USER)
db_password=$(docker exec application-backend-1 printenv DB_PASSWORD)
db_host=$(docker exec application-backend-1 printenv DB_HOST)
db_port=$(docker exec application-backend-1 printenv DB_PORT)
db_name=$(docker exec application-backend-1 printenv DB_NAME)
[[ -n "$db_user" && -n "$db_password" && -n "$db_host" && "$db_port" =~ ^[0-9]+$ && -n "$db_name" ]] || exit 1

MYSQL_PWD="$db_password" mysqldump \
  -h "$db_host" -P "$db_port" -u "$db_user" \
  --single-transaction --no-tablespaces --routines --triggers \
  --set-gtid-purged=OFF "$db_name" | gzip -c > "$tmp"
gzip -t "$tmp"
chmod 600 "$tmp"
mv -f -- "$tmp" "$target"
trap - EXIT HUP INT TERM
printf 'PRODUCTION_BACKUP=PASS\n'
