  rows=json.loads(p.stdout);need(len(rows)==1);d=rows[0]
  need(image in d.get('RepoDigests',[]) and d.get('Os')=='linux' and d.get('Architecture')=='amd64')
  need(d.get('Config',{}).get('Labels',{}).get('org.opencontainers.image.revision')==RELEASE)
  if image==BACKEND:
   mig=command(['docker','--config',config,'run','--rm','--network','none','--read-only','--entrypoint','python',image,'-B','-c',"from hashlib import sha256; from pathlib import Path; d=sha256(); root=Path('/app'); files=sorted(root.glob('apps/*/migrations/*.py')); [(d.update(str(p.relative_to(root)).encode()),d.update(p.read_bytes())) for p in files]; print(d.hexdigest())"],180,env=dict(os.environ,DOCKER_CONFIG=config)).strip()
   need(mig==MIGRATION)
def safe_login(user):
 need(user and len(user)<=100 and user[0].isalnum() and all(c.isalnum() or c in '_.-' for c in user))
 script='set -Eeuo pipefail; source "$1"; new_docker_config; cleanup_auth(){ local status=$?; trap - EXIT; remove_docker_config; exit "$status"; }; trap cleanup_auth EXIT; trap "exit 129" HUP; trap "exit 130" INT; trap "exit 143" TERM; docker_login_from_stdin "$2"; printf "%s\\n" "$DOCKER_CONFIG"; trap - EXIT HUP INT TERM'
 p=subprocess.run(['timeout','--signal=TERM','--kill-after=15s','105s','bash','-c',script,'precache-auth',str(COMMON),user],input=sys.stdin.buffer.read(),capture_output=True,timeout=125)
