 config=Path(rows[0]);need(config.parent==C and config.is_dir() and not config.is_symlink())
 need(stat.S_IMODE(config.stat().st_mode)==0o700)
 return str(config)
def arguments():
 result={}
 for token in sys.argv[1:]:
  need('=' in token);key,value=token[2:].split('=',1);need(key in ('cache-controller-sha','registry-user') and key not in result and value)
  result[key]=value
 need(set(result)=={'cache-controller-sha','registry-user'})
 need(len(result['cache-controller-sha'])==40 and all(c in '0123456789abcdef' for c in result['cache-controller-sha']))
 return result
def active_docker_pull():
 for line in command(['ps','-eo','args=']).splitlines():
  try: argv=shlex.split(line)
  except ValueError: return True
  for i,token in enumerate(argv):
   if Path(token).name!='docker': continue
   rest=argv[i+1:]
   if rest and rest[0]=='pull': return True
   if len(rest)>=3 and rest[0]=='--config' and rest[2]=='pull': return True
 return False
def post_readback(before):
 try:
  after=target_snapshot();digest=sha(json.dumps(after,sort_keys=True,separators=(',',':')).encode())
  return ('unchanged' if after==before else 'changed',digest)
 except Exception:
  return ('readback_failed',None)
def failure(kind,log_path,calls,before):
 state,digest=post_readback(before) if before is not None else ('not_started',None)
 record={'status':'failed_closed','error_class':kind,'pull_count':len(calls),
         'post_readback':state,'post_state_sha256':digest}
 if log_path and Path(log_path).exists():record['log_sha256']=fsha(log_path)
 print(json.dumps(record));return 1
def main():
 args=arguments()
 need(os.geteuid()==0);need(COMMON.is_file() and not COMMON.is_symlink())
 handles=[];config=None;calls=[];logs=[];before=None
 try:
  for lock in LOCKS:
   h=lock.open('r');fcntl.flock(h,fcntl.LOCK_EX|fcntl.LOCK_NB);handles.append(h)
  before=target_snapshot()
  need(not active_docker_pull())
  ledger=C/'ledger';need(ledger.is_dir() and not ledger.is_symlink())
  config=safe_login(args['registry-user'])
  total=0;layers=0;env=dict(os.environ,DOCKER_CONFIG=config)
  for image in IMAGES:
   total_part,n=manifest_layers(image,env);total+=total_part;layers+=n
  docker_root=command(['docker','info','--format','{{.DockerRootDir}}']).strip();need(docker_root.startswith('/'))
  usage=shutil.disk_usage(docker_root);st=os.statvfs(docker_root)
  need(usage.free >= total*4+5*1024**3 and st.f_favail >= max(10000,layers*20))
  for index,image in enumerate(IMAGES):
   cached(image,config,False)
   fd,path=tempfile.mkstemp(prefix='precache316-run40515060731-',suffix='.log',dir=ledger);os.fchmod(fd,0o600);logs.append(Path(path))
   try:
    with os.fdopen(fd,'wb') as log:
     calls.append(image)
     p=subprocess.run(['timeout','--foreground','--signal=TERM','--kill-after=30s','900s','docker','--config',config,'pull',image],stdout=log,stderr=subprocess.STDOUT,timeout=940)
    if p.returncode:
     raw=logs[-1].read_bytes().lower();kind='timeout' if p.returncode in (124,137) or b'timed out' in raw else ('eof' if b'eof' in raw else 'pull_error')
     return failure(kind,logs[-1],calls,before)
   except Exception:
    raw=logs[-1].read_bytes().lower();kind='timeout' if b'timed out' in raw else ('eof' if b'eof' in raw else 'pull_error')
    return failure(kind,logs[-1],calls,before)
   cached(image,config,True)
  need(target_snapshot()==before)
  print(json.dumps({'status':'cache_only_complete','workflow_run_id':RUN,'attempt':2,'release_sha':RELEASE,'release_controller_sha':CONTROLLER,'cache_controller_sha':args['cache-controller-sha'],'manifest_sha256':MANIFEST_SHA,'pull_count':len(calls),'images':list(IMAGES),'log_sha256':[fsha(p) for p in logs]}));return 0
 except Exception:
  state,digest=post_readback(before) if before is not None else ('not_started',None)
  print(json.dumps({'status':'failed_closed','error_class':'precondition_or_validation','pull_count':len(calls),'post_readback':state,'post_state_sha256':digest,'log_sha256':[fsha(p) for p in logs if p.exists()]}));return 2
 finally:
  if config and Path(config).exists():shutil.rmtree(config)
  for h in reversed(handles):h.close()
if __name__=='__main__':sys.exit(main())
