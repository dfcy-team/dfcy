def need(x):
 if not x: raise RuntimeError('precondition')
def sha(b): return hashlib.sha256(b).hexdigest()
def fsha(p):
 p=Path(p);st=p.lstat();need(stat.S_ISREG(st.st_mode) and not p.is_symlink());return sha(p.read_bytes())
def tree(root):
 root=Path(root);need(root.is_dir() and not root.is_symlink());h=hashlib.sha256()
 for p in sorted(root.rglob('*'),key=lambda x:x.relative_to(root).as_posix()):
  need(not p.is_symlink());rel=p.relative_to(root).as_posix().encode();h.update(b'D' if p.is_dir() else b'F');h.update(len(rel).to_bytes(8,'big'));h.update(rel)
  if p.is_file():
   b=p.read_bytes();h.update(len(b).to_bytes(8,'big'));h.update(b)
 return h.hexdigest()
def command(args,timeout=120,input_text=None,env=None):
 p=subprocess.run(args,input=input_text,text=True,capture_output=True,timeout=timeout,env=env)
 need(p.returncode==0);return p.stdout
