def manifest_layers(image,env):
 root=json.loads(command(['docker','manifest','inspect',image],180,env=env))
 if 'manifests' in root:
  rows=[x for x in root['manifests'] if x.get('platform',{}).get('os')=='linux' and x.get('platform',{}).get('architecture')=='amd64'];need(len(rows)==1)
  name=image.split('@',1)[0]+'@'+rows[0]['digest'];root=json.loads(command(['docker','manifest','inspect',name],180,env=env))
 need(root.get('mediaType','').endswith(('manifest.v2+json','image.manifest.v1+json')))
 layers=root.get('layers');need(isinstance(layers,list) and layers)
 return sum(int(x['size']) for x in layers),len(layers)
def cached(image,config,expect_present):
