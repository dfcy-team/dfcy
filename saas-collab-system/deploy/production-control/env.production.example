# Copy this file to the root-owned production environment path configured by
# config/env.path. This example contains no usable credentials and must never
# be used as the live file.

PRODUCTION_ENVIRONMENT_CODE=production
PRODUCTION_DEPLOY_USER=dfcy01

# The following paths are operator-controlled. All paths must be absolute.
# PRODUCTION_COMPOSE_FILES accepts a colon-separated list of reviewed files;
# this permits the existing Pilot/Production overlay chain to be retained.
PRODUCTION_COMPOSE_PROJECT_DIR=/opt/saas-collab/dfcy/saas-collab-system/deploy/pilot/application
PRODUCTION_COMPOSE_FILES=/opt/saas-collab/release-control/unified/production-compose.yml
PRODUCTION_RUNTIME_ENV_FILE=/etc/saas-collab/production/.env.production
PRODUCTION_BASELINE_FILE=/opt/saas-collab/release-control/unified/config/baseline.sha256
PRODUCTION_AUDIT_FILE=/opt/saas-collab/release-control/unified/ledger/audit.jsonl
PRODUCTION_LOCK_FILE=/opt/saas-collab/release-control/unified/locks/production-release.lock

# The pilot runner is an independent systemd service on the VM. These values
# contain no credentials; the URL hostname must match the runner certificate
# SAN and the allow-list must contain only that hostname. The three source
# paths below are root-owned read-only secret files provisioned outside Git.
PRODUCTION_RUNNER_URL=https://host.docker.internal:9444
PRODUCTION_RUNNER_ALLOWED_HOSTS=host.docker.internal
PRODUCTION_OPENAI_API_KEY_PATH=/etc/saas-collab/secrets/openai-api.key
PRODUCTION_RUNNER_TOKEN_PATH=/etc/saas-collab/runner/secrets/runner.token
PRODUCTION_RUNNER_CA_PATH=/etc/saas-collab/runner/tls/backend-ca.pem

# Custody sidecar image and owner-provisioned files. The image placeholder is
# intentionally unusable until CI/architecture replaces it with an immutable
# digest. None of the paths below should point into the source checkout.
PRODUCTION_CUSTODY_IMAGE=ghcr.io/dfcy-team/dfcy/saas-collab-custody@sha256:change-me-64-character-digest
PRODUCTION_CUSTODY_MASTER_KEY_PATH=/etc/saas-collab/custody/custody-master.key
PRODUCTION_CUSTODY_SERVICE_TOKEN_PATH=/etc/saas-collab/custody/custody-service.token
PRODUCTION_CUSTODY_CA_PATH=/etc/saas-collab/custody/tls/ca.pem
PRODUCTION_CUSTODY_TLS_CERT_PATH=/etc/saas-collab/custody/tls/tls.crt
PRODUCTION_CUSTODY_TLS_KEY_PATH=/etc/saas-collab/custody/tls/tls.key
PRODUCTION_CUSTODY_DATA_PATH=/var/lib/saas-collab/custody
PRODUCTION_CUSTODY_SIDECAR_UID=1000
PRODUCTION_CUSTODY_SIDECAR_GID=1000

# These image values are replaced by the fixed release entrypoint at runtime.
# They are deliberately invalid placeholders in this example.
PRODUCTION_BACKEND_IMAGE=ghcr.io/dfcy-team/dfcy/saas-collab-backend@sha256:change-me-64-character-digest
PRODUCTION_FRONTEND_IMAGE=ghcr.io/dfcy-team/dfcy/saas-collab-frontend@sha256:change-me-64-character-digest
PRODUCTION_REDIS_IMAGE=redis@sha256:change-me-64-character-digest

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-generate-a-unique-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=change-me-production-host,localhost,backend
CORS_ALLOWED_ORIGINS=https://change-me-production-host:8443

DB_ENGINE=django.db.backends.mysql
DB_NAME=saas_collab_production
DB_USER=saas_collab_production_user
DB_PASSWORD=change-me-production-db-password
DB_HOST=change-me-private-database-host
DB_PORT=3306

REDIS_PASSWORD=change-me-production-redis-password
REDIS_URL=redis://:change-me-production-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-production-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-production-redis-password@redis:6379/0
SYNC_JOB_LEASE_SECONDS=900

INTEGRATION_ENCRYPTION_PROVIDER=unconfigured-production
PRODUCTION_APP_PORT=8000
PRODUCTION_HTTP_PORT=8080
PRODUCTION_HTTPS_PORT=8443
PRODUCTION_TLS_CERT_PATH=/etc/saas-collab/tls/production.crt
PRODUCTION_TLS_KEY_PATH=/etc/saas-collab/tls/production.key
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# A successful, root-owned backup hook is required before a production
# migration. Its output is suppressed by the release script.
PRODUCTION_REQUIRE_BACKUP=true
PRODUCTION_BACKUP_COMMAND=/usr/local/sbin/saas-collab-production-backup
PRODUCTION_MIGRATION_SERVICE=migrate
PRODUCTION_BACKEND_SERVICE=backend
PRODUCTION_FRONTEND_SERVICE=frontend
PRODUCTION_REDIS_SERVICE=redis
PRODUCTION_REQUIRED_SERVICES=redis,backend,celery,celery-beat,frontend
