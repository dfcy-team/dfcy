# Owner-managed runner paths.  This file is documentation only; do not copy
# credentials or replace the JSON config with values from a request.
PILOT_RUNNER_CONFIG_FILE=/etc/saas-collab/runner/config.json
PILOT_RUNNER_TOKEN_FILE=/etc/saas-collab/runner/secrets/runner.token
PILOT_RUNNER_MANIFEST_FILE=/etc/saas-collab/runner/approved-candidate.json
PILOT_RUNNER_REGISTRY_TOKEN_FILE=/etc/saas-collab/runner/registry-token
PILOT_RUNNER_STATE_FILE=/var/lib/saas-collab/pilot-runner/state.sqlite3
PILOT_RUNNER_AUDIT_FILE=/var/lib/saas-collab/pilot-runner/audit.jsonl
PILOT_RUNNER_EVIDENCE_DIR=/var/lib/saas-collab/pilot-runner/evidence

# A remote operator must use the owner-approved SSH port/key.  The externally
# observed service is checked through the configured control port; the current
# controlled SSH entrypoint is 22131 (the VM internal address may use 22).
PILOT_VM_HOST=192.168.2.10
PILOT_VM_SSH_PORT=22131
