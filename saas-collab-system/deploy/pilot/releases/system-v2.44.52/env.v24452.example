# V2.44.52 release inputs. Copy the required values to the protected
# application VM .env.pilot; never commit the populated file.
#
# Optional: when set, the chain must contain the exact compose override files
# that currently make up the application service graph and use ':' as the
# separator. Older baselines may leave it empty; the release then reads the
# exact chain from the running application-frontend-1 Compose label.
PILOT_RELEASE_CHAIN_ROOT=/home/dfcy01/releases
PILOT_RELEASE_COMPOSE_CHAIN=
PILOT_REPO_DIR=/home/dfcy01/releases/system-v2.44.52-e3dc85b-20260901/reviewed-source
PILOT_SOURCE_DIR=/home/dfcy01/releases/system-v2.44.52-e3dc85b-20260901/reviewed-source/saas-collab-system
PILOT_APP_DIR=/opt/saas-collab/dfcy/saas-collab-system/deploy/pilot/application
PILOT_BASE_COMPOSE_FILE=/opt/saas-collab/dfcy/saas-collab-system/deploy/pilot/application/docker-compose.pilot-app.yml
PILOT_RELEASE_MIRROR=/home/dfcy01/releases/developer-a-authorized-releases/git-mirror.git
PILOT_CANONICAL_REF=refs/baselines/canonical-deployed
PILOT_RELEASE_CONTROL_ROOT=/opt/saas-collab/release-control/unified
PILOT_LEGACY_RELEASE_CONTROL_ROOT=/opt/saas-collab/release-control/shared-version-ledger
PILOT_RELEASE_ACTOR=architect

# Database migration and backup use the application connection already held
# by .env.pilot. The script requires these exact non-secret identity values;
# it never reads .influencers-migration.cnf, escalates privileges, or changes
# grants. Do not add DB_PASSWORD here: the populated .env.pilot is protected
# on the application VM and is never copied into this bundle.
PILOT_APPLICATION_DB_USER=saas_collab_pilot_user
PILOT_APPLICATION_DB_NAME=saas_collab_pilot

# Dedicated encrypted custody paths are inherited from V2.44.50. They are
# listed here only as paths; do not replace them with secret values.
PILOT_CUSTODY_SIDECAR_UID=1000
PILOT_CUSTODY_SIDECAR_GID=1000
PILOT_CUSTODY_MASTER_KEY_PATH=/srv/saas-collab/custody-secrets/custody-master.key
PILOT_CUSTODY_DATA_PATH=/srv/saas-collab/custody-data
PILOT_CUSTODY_SERVICE_TOKEN_PATH=/srv/saas-collab/custody-secrets/custody-service.token
PILOT_CUSTODY_CA_PATH=/srv/saas-collab/custody-secrets/custody-ca.pem
PILOT_CUSTODY_TLS_CERT_PATH=/srv/saas-collab/custody-secrets/custody-tls.crt
PILOT_CUSTODY_TLS_KEY_PATH=/srv/saas-collab/custody-secrets/custody-tls.key

# Evidence is outside the Git checkout on the VM. It must not be a symlink.
# PILOT_RELEASE_EVIDENCE_DIR=/home/dfcy01/releases/system-v2.44.52-build-YYYYMMDD
