# Copy to .env.pilot on the controlled pilot host. Do not commit .env.pilot.
PILOT_ENVIRONMENT_CODE=controlled-pilot
PILOT_RELEASE_GIT_SHA=change-me-40-character-approved-main-commit
PILOT_ARTIFACT_MANIFEST_FILE=/etc/saas-collab/promotion/sandbox-artifact-manifest.json
PILOT_SANDBOX_EVIDENCE_FILE=/etc/saas-collab/promotion/sandbox-verification-evidence.json
PILOT_BACKEND_IMAGE=ghcr.io/dfcy-team/dfcy/saas-collab-backend@sha256:change-me-64-character-sandbox-verified-digest
PILOT_FRONTEND_IMAGE=ghcr.io/dfcy-team/dfcy/saas-collab-frontend@sha256:change-me-64-character-sandbox-verified-digest
PILOT_REDIS_IMAGE=redis@sha256:change-me-64-character-approved-digest
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-generate-a-unique-pilot-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=change-me-application-host-ip,localhost,backend
CORS_ALLOWED_ORIGINS=https://change-me-application-hostname:8443

DB_ENGINE=django.db.backends.mysql
DB_NAME=saas_collab_pilot
DB_USER=saas_collab_pilot_user
DB_PASSWORD=change-me-mysql-user-password
DB_HOST=change-me-database-host-ip
DB_PORT=3306

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-redis-password@redis:6379/0
SYNC_JOB_LEASE_SECONDS=900

# Real-platform configuration. This committed file contains no credential value.
# Keep both gates disabled until a fixed artifact, approved custody service and
# the platform contracts have been independently reviewed.
PLATFORM_NETWORK_MODE=
LIVE_PLATFORM_SECURITY_APPROVED=false
LIVE_PLATFORM_ALLOWED_HOSTS=partner.shopeemobile.com,services.tiktokshop.com,auth.tiktok-shops.com,open-api.tiktokglobalshop.com,change-me-approved-custody-host
LIVE_PLATFORM_CONNECT_TIMEOUT=3
LIVE_PLATFORM_READ_TIMEOUT=8
LIVE_PLATFORM_MAX_RETRIES=2
LIVE_PLATFORM_BACKOFF_BASE=0.5
LIVE_PLATFORM_MAX_RETRY_WAIT=8
LIVE_PLATFORM_MAX_TOTAL_WAIT=15

# Local custody is a dedicated host volume mounted only into backend workers.
# Never put an App Secret, access token or refresh token in .env.pilot.
LIVE_CUSTODY_BACKEND=file
CREDENTIAL_CUSTODY_PATH=/var/lib/saas-collab/credential-custody
LIVE_CUSTODY_SERVICE_URL=
LIVE_CUSTODY_SERVICE_HOST=

LIVE_OAUTH_REDIRECT_ALLOWLIST=https://dingfengchuangyu.com/api/internal/integrations/store-authorizations/oauth/callback/shopee/,https://dingfengchuangyu.com/api/internal/integrations/store-authorizations/oauth/callback/tiktok/

# Shopee pilot markets: Philippines (PH), Thailand (TH), Malaysia (MY).
# Official endpoint paths/host must be copied from the approved Shopee console
# contract on deployment day; placeholders deliberately block live requests.
LIVE_SHOPEE_PARTNER_ID=change-me-approved-public-partner-id
LIVE_SHOPEE_APP_SECRET_REFERENCE=change-me-custody-reference-only
LIVE_SHOPEE_REDIRECT_URI=https://dingfengchuangyu.com/api/internal/integrations/store-authorizations/oauth/callback/shopee/
LIVE_SHOPEE_CONTRACT_APPROVED=false
LIVE_SHOPEE_AUTH_URL=REPLACE_ME_CONFIRMED_ON_EXECUTION_DAY
LIVE_SHOPEE_TOKEN_PATH=REPLACE_ME_CONFIRMED_ON_EXECUTION_DAY
LIVE_SHOPEE_REFRESH_PATH=REPLACE_ME_CONFIRMED_ON_EXECUTION_DAY
LIVE_SHOPEE_REVOKE_PATH=REPLACE_ME_CONFIRMED_ON_EXECUTION_DAY
LIVE_SHOPEE_SHOP_PATH=REPLACE_ME_CONFIRMED_ON_EXECUTION_DAY
LIVE_SHOPEE_SIGN_SCHEME=v2
LIVE_SHOPEE_DEFAULT_REGION=PH
LIVE_SHOPEE_DEFAULT_HOST=REPLACE_ME_CONFIRMED_ON_EXECUTION_DAY

# TikTok PH/TH/MY all use the ROW application market. Reconfirm every endpoint
# and scope against the approved Partner Center application before enabling.
LIVE_TIKTOK_APP_KEY=change-me-approved-public-app-key
LIVE_TIKTOK_APP_SECRET_REFERENCE=change-me-custody-reference-only
LIVE_TIKTOK_REDIRECT_URI=https://dingfengchuangyu.com/api/internal/integrations/store-authorizations/oauth/callback/tiktok/
LIVE_TIKTOK_CONTRACT_APPROVED=false
LIVE_TIKTOK_SERVICE_ID=change-me-approved-public-service-id
LIVE_TIKTOK_MARKET=ROW
LIVE_TIKTOK_DEFAULT_AUTH_URL=https://services.tiktokshop.com/open/authorize
LIVE_TIKTOK_DEFAULT_OPEN_HOST=https://open-api.tiktokglobalshop.com
LIVE_TIKTOK_TOKEN_HOST=https://auth.tiktok-shops.com
LIVE_TIKTOK_TOKEN_PATH=/api/v2/token/get
LIVE_TIKTOK_REFRESH_PATH=/api/v2/token/refresh
LIVE_TIKTOK_REVOKE_PATH=REPLACE_ME_CONFIRMED_ON_EXECUTION_DAY
LIVE_TIKTOK_AUTHORIZED_SHOPS_PATH=/authorization/202309/shops
LIVE_TIKTOK_METADATA_PATH=/seller/202309/permissions
LIVE_TIKTOK_DEFAULT_SCOPE=

# Pilot safety: legacy integration credential storage stays disabled.
INTEGRATION_ENCRYPTION_PROVIDER=unconfigured-production
PILOT_APP_PORT=8000
PILOT_HTTP_PORT=8080
PILOT_HTTPS_PORT=8443
PILOT_TLS_CERT_PATH=/etc/saas-collab/tls/change-me-pilot.crt
PILOT_TLS_KEY_PATH=/etc/saas-collab/tls/change-me-pilot.key
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
