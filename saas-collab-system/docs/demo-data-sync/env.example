# Intranet service only. Defaults below are intentionally disabled.
DJANGO_SETTINGS_MODULE=config.settings.demo_sync_service
DEMO_DATA_SYNC_ENABLED=false
DEMO_DATA_SYNC_WORKER_ENABLED=false
DEMO_DATA_SYNC_IMPORT_ENABLED=false
DEMO_DATA_SYNC_SOURCE_URL=https://approved-source.example
DEMO_DATA_SYNC_ALLOWED_HOSTS=approved-source.example
# Optional private CA certificate file. TLS verification remains enabled.
DEMO_DATA_SYNC_CA_BUNDLE=
DEMO_DATA_SYNC_TENANT_ID=0
# Absolute private directory; never MEDIA_ROOT or a public share.
DEMO_DATA_SYNC_ARTIFACT_ROOT=/var/lib/demo-data-sync/private
# Inject these secret values externally. Do not commit them.
DEMO_SYNC_CLIENT_ID=
DEMO_SYNC_CLIENT_SECRET=
DEMO_SYNC_MASKING_KEY=
# Independent intranet MySQL / Django secret; no production configuration copy.
DB_ENGINE=django.db.backends.mysql
DB_NAME=saas_collab_sync_control
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost
