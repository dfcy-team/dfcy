# 复制为 local.env 后修改

LISTEN_HOST=0.0.0.0
# 本机开发用 8080（无需管理员）；服务器部署用 80
LISTEN_PORT=8080
SITE_DOMAIN=127.0.0.1
SITE_BRAND=鼎峰 TikTok Shop 数据平台
COMPANY_NAME=厦门市鼎峰创域科技有限公司
CONTACT_EMAIL=postmaster@dingfengchuangyu.top
CONTACT_ADDRESS=福建省福州市厦门市厦门火炬高新区软件园三期溪西山尾路3号1901-4
PRODUCTION_SITE=dingfengchuangyu.top
PRODUCTION_CALLBACK_URL=http://dingfengchuangyu.top/callback
CALLBACK_PATH=/callback
INFO_PATH=/ruike

# 服务器 + Nginx HTTPS 反代（Flask 只监听本机，Nginx 占 80/443）:
# LISTEN_HOST=127.0.0.1
# LISTEN_PORT=8080
# SITE_DOMAIN=dingfengchuangyu.com          # 网页浏览用 .com
# PRODUCTION_SITE=dingfengchuangyu.top      # TikTok 授权/回调仍用 .top
# PRODUCTION_CALLBACK_URL=https://dingfengchuangyu.top/callback
# TTS_REDIRECT_URL=https://dingfengchuangyu.top/callback
# 见 deploy/nginx/README_HTTPS_Windows.md

# 可选：覆盖 app.env
# TTS_APP_KEY=
# TTS_APP_SECRET=
# TTS_SERVICE_ID=7641963005262366481

TIKTOK_AUTO_EXCHANGE=true
FLASK_SECRET_KEY=change-this-secret-key

# MySQL 用户权限库（网站登录账号，后续接入）
DB_HOST=127.0.0.1
DB_PORT=3360
DB_USER=dingfeng
DB_PASSWORD=
DB_NAME=dingfeng_portal
