# 复制为 local.env 后修改

LISTEN_HOST=0.0.0.0
# 本机开发用 8080（无需管理员）；服务器部署用 80
LISTEN_PORT=8080
SITE_DOMAIN=127.0.0.1
SITE_BRAND=鼎峰 TikTok Shop 数据平台
COMPANY_NAME=厦门市鼎峰创域科技有限公司
CONTACT_EMAIL=postmaster@dingfengchuangyu.com
CONTACT_ADDRESS=福建省福州市厦门市厦门火炬高新区软件园三期溪西山尾路3号1901-4
PRODUCTION_SITE=dingfengchuangyu.com
PRODUCTION_CALLBACK_URL=https://dingfengchuangyu.com/callback
CALLBACK_PATH=/callback
INFO_PATH=/ruike

# 服务器 + Nginx HTTPS 反代（Flask 只监听本机，Nginx 占 80/443）:
# LISTEN_HOST=127.0.0.1
# LISTEN_PORT=8080
# SITE_DOMAIN=dingfengchuangyu.com
# PRODUCTION_SITE=dingfengchuangyu.com
# PRODUCTION_CALLBACK_URL=https://dingfengchuangyu.com/callback
# TTS_REDIRECT_URL=https://dingfengchuangyu.com/callback
# 见 deploy/nginx/README_HTTPS_Windows.md

# 可选：覆盖 app.env
# TTS_APP_KEY=
# TTS_APP_SECRET=
# TTS_SERVICE_ID=7641963005262366481

TIKTOK_AUTO_EXCHANGE=true
FLASK_SECRET_KEY=change-this-secret-key

# 临时关闭网站登录（改回 true 或删除此行即可恢复）
PORTAL_LOGIN_REQUIRED=false

# 数据库见 db.env（复制 db.env.example，不提交 Git）
# PORTAL_ADMIN_USER=admin
# PORTAL_ADMIN_PASSWORD=dfcyadmin
