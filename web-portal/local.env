# 服务器正式环境 — Nginx HTTPS → Flask 127.0.0.1:8080
#
# 网页与 TikTok Shop / 广告 Marketing OAuth 回调均用 dingfengchuangyu.com

LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
SITE_DOMAIN=dingfengchuangyu.com
SITE_BRAND=鼎峰 TikTok Shop 数据平台
COMPANY_NAME=厦门市鼎峰创域科技有限公司
CONTACT_EMAIL=postmaster@dingfengchuangyu.com
CONTACT_ADDRESS=福建省福州市厦门市厦门火炬高新区软件园三期溪西山尾路3号1901-4
PRODUCTION_SITE=dingfengchuangyu.com
PRODUCTION_CALLBACK_URL=https://dingfengchuangyu.com/callback
CALLBACK_PATH=/callback
INFO_PATH=/ruike

TTS_REDIRECT_URL=https://dingfengchuangyu.com/callback

TIKTOK_AUTO_EXCHANGE=true
FLASK_SECRET_KEY=dingfeng-tiktok-web-2026-prod

# 临时关闭网站登录
PORTAL_LOGIN_REQUIRED=false

# 数据库见 db.env（不提交 Git，复制 db.env.example）
